##############################################################################
# Phase 13 — n8n Queue Mode Environment
# Copy to .env and fill in real values. Never commit .env.
#
# Generate secrets:
#   N8N_ENCRYPTION_KEY      : openssl rand -hex 32
#   REDIS_PASSWORD          : openssl rand -hex 24
#   N8N_DB_PASSWORD         : openssl rand -hex 24
#   N8N_WEBHOOK_HMAC_SECRET : openssl rand -hex 32
#   BACKEND_INTERNAL_SECRET : openssl rand -hex 32
#
# SSL note:
#   DB_POSTGRESDB_SSL_ENABLED is hardcoded to "false" in docker-compose.yml.
#   The local Postgres container does not have SSL configured, so TLS must
#   be disabled at the n8n level. Do not set any DB_POSTGRESDB_SSL_* vars
#   here — they are managed entirely in the compose file.
##############################################################################

# ------------------------------------------------------------------------------
# n8n core
# ------------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PROTOCOL=http

# Public URL n8n announces for webhooks. In production this is your domain.
# Example: https://automation.yourdomain.com
N8N_WEBHOOK_URL=http://localhost:5678

# URL shown in the editor (can differ from webhook URL if behind a proxy)
N8N_EDITOR_BASE_URL=http://localhost:5678

# 32-byte hex key used to encrypt credentials stored in Postgres.
# Changing this invalidates all stored credentials — treat like a root secret.
N8N_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# n8n-postgres (n8n-owned database, NOT the application Supabase)
# These three vars must be consistent: docker-compose passes them to both
# the Postgres container (POSTGRES_*) and to n8n (DB_POSTGRESDB_*).
# ------------------------------------------------------------------------------
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=REPLACE_WITH_openssl_rand_hex_24

# ------------------------------------------------------------------------------
# Redis (BullMQ queue broker + Phase 13.2 idempotency/metrics on DB 1)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=REPLACE_WITH_openssl_rand_hex_24

# ------------------------------------------------------------------------------
# HMAC signing shared secret
# Used by FastAPI to sign outbound events; validated inside n8n Code nodes.
# Both sides must use the same value.
# ------------------------------------------------------------------------------
N8N_WEBHOOK_HMAC_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# FastAPI → n8n integration (used by backend/app/events/config.py)
# ------------------------------------------------------------------------------

# Base URL reachable from inside the Docker internal network.
# The backend container reaches n8n-main via the shared eduaiplatform_internal net.
N8N_BASE_URL=http://n8n-main:5678

# Webhook path prefixes (must match workflow webhook nodes)
N8N_WEBHOOK_PATH_FILE_UPLOAD=webhook/file-upload-event
N8N_WEBHOOK_PATH_LOW_CONFIDENCE=webhook/low-confidence-alert
N8N_WEBHOOK_PATH_PIPELINE_FAILURE=webhook/pipeline-failure

# HTTP timeout for event emission (seconds)
N8N_EMIT_TIMEOUT_SECONDS=10

# Retry on network failure before giving up (not the same as workflow retry)
N8N_EMIT_MAX_RETRIES=3

# Signature header name (must match n8n Code node)
N8N_SIGNATURE_HEADER=X-EduAI-Signature-256

# Timestamp header name
N8N_TIMESTAMP_HEADER=X-EduAI-Timestamp

# Idempotency header name
N8N_IDEMPOTENCY_HEADER=X-EduAI-Idempotency-Key

# Max clock skew allowed when validating incoming timestamps (seconds)
N8N_TIMESTAMP_TOLERANCE_SECONDS=300

# ------------------------------------------------------------------------------
# Phase 13.2 — Distributed idempotency + metrics (Redis DB 1)
# Redis DB 0 is reserved for BullMQ. DB 1 is used by the backend for
# idempotency keys and metric counters.
# REDIS_URL must use the same password as REDIS_PASSWORD above.
# ------------------------------------------------------------------------------
REDIS_URL=redis://:REPLACE_WITH_SAME_AS_REDIS_PASSWORD@n8n-redis:6379/1

# ------------------------------------------------------------------------------
# Phase 13.2 — Backend internal API auth
# n8n workflows call /internal/* endpoints on the backend using this secret.
# IMPORTANT: must match BACKEND_INTERNAL_SECRET in the backend .env.
# ------------------------------------------------------------------------------
BACKEND_INTERNAL_SECRET=REPLACE_WITH_openssl_rand_hex_32

# URL the backend is reachable at from n8n workers (eduaiplatform_internal network)
BACKEND_INTERNAL_URL=http://backend:8000

# ------------------------------------------------------------------------------
# Phase 13.3 — HITL approval workflow
# ------------------------------------------------------------------------------
N8N_WEBHOOK_PATH_HITL_APPROVAL=webhook/admin-approval-hitl

# ------------------------------------------------------------------------------
# Phase 14 — Multi-Model Assessment Layer
# Provider API keys used by n8n Code/HTTP nodes (not by the backend directly).
# Store these as n8n credentials OR expose via docker-compose environment.
# ------------------------------------------------------------------------------

# OpenAI API key — used by student_assessment and professor_assessment workflows
OPENAI_API_KEY=REPLACE_WITH_your_openai_api_key

# Anthropic API key — used for Claude consistency review pass
ANTHROPIC_API_KEY=REPLACE_WITH_your_anthropic_api_key

# Google AI (Gemini) API key — used for conditional multimodal extraction
GOOGLE_AI_API_KEY=REPLACE_WITH_your_google_ai_api_key

# Phase 14 webhook paths (must match workflow webhook node paths)
N8N_WEBHOOK_PATH_ASSESSMENT_STUDENT=webhook/ai-assessment-student
N8N_WEBHOOK_PATH_ASSESSMENT_PROFESSOR=webhook/ai-assessment-professor

# Daily cost budget for model usage (USD). Admin alert fires if exceeded.
# Used by admin_model_usage_audit workflow.
ASSESSMENT_DAILY_BUDGET_USD=50

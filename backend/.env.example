# ===== Core =====
ENV=development
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# ===== JWT (dev only, not used for Supabase auth) =====
JWT_SECRET=change_me_dev_only

# ===== Supabase =====
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=service_role_key_here

# ===== Storage =====
UPLOADS_BUCKET=edu-uploads
SIGNED_URL_EXPIRES_SECONDS=60

# ===== ClamAV =====
CLAMD_HOST=clamav
CLAMD_PORT=3310

# ===== Retention =====
ASSIGNMENT_RETENTION_DAYS=180
AI_ARTIFACT_RETENTION_DAYS=30

# ===== Internal services =====
PARSER_URL=http://parser:8020
PARSER_SECRET=dev_parser_secret
AI_SERVICE_URL=http://ai-service:8010
AI_SERVICE_SECRET=change_me_dev_only
LLM_SERVICE_URL=http://llm-service:8030
LLM_SERVICE_SECRET=change_me_dev_only

# ===== Ollama / model routing =====
OLLAMA_PRIMARY_MODEL=gemma3:4b
OLLAMA_FALLBACK_MODEL=phi3:mini
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_NUM_CTX=8192
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.12
LLM_PRIMARY_LABEL=gemma3:4b
LLM_FALLBACK_LABEL=phi3:mini

# ===== Phase 10 rich feedback tuning =====
PHASE10_TIMEOUT_SECONDS=120
PHASE10_STUDENT_TIMEOUT_SECONDS=180
PHASE10_PROFESSOR_TIMEOUT_SECONDS=180
PHASE10_STUDENT_TEMPERATURE=0.15
PHASE10_PROFESSOR_TEMPERATURE=0.15
PHASE10_STUDENT_DEFAULT_OUTPUT_TOKENS=1200
PHASE10_PROFESSOR_DEFAULT_OUTPUT_TOKENS=1200
PHASE10_STUDENT_MIN_OUTPUT_TOKENS=850
PHASE10_PROFESSOR_MIN_OUTPUT_TOKENS=900
PHASE10_STUDENT_MAX_OUTPUT_TOKENS=1400
PHASE10_PROFESSOR_MAX_OUTPUT_TOKENS=1400
PHASE10_OUTPUT_BUDGET_SHORT_CHARS=2500
PHASE10_OUTPUT_BUDGET_MEDIUM_CHARS=7000
PHASE10_MAX_CONTEXT_CHARS=18000

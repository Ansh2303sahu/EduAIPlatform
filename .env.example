# ---------- Shared ----------
ENV=development

# ---------- Backend ----------
BACKEND_PORT=8000
JWT_SECRET=change_me_dev_only
ALLOWED_ORIGINS=http://localhost:3000

# Supabase (backend-only secrets must NEVER go to frontend)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=public_anon_key_ok_to_expose_if_needed
SUPABASE_SERVICE_ROLE_KEY=service_role_secret_backend_only

# Storage bucket name
ASSIGNMENTS_BUCKET=assignments

# Retention
ASSIGNMENT_RETENTION_DAYS=180
AI_ARTIFACT_RETENTION_DAYS=30

# ---------- AI Service ----------
AI_SERVICE_PORT=8010
AI_SERVICE_SECRET=change_me_dev_only
AI_NO_EXTERNAL_BROWSING=true
AI_NO_CROSS_USER_ACCESS=true

# ---------- Local LLM / Ollama ----------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_PRIMARY_MODEL=gemma3:4b
OLLAMA_FALLBACK_MODEL=phi3:mini
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1200
OLLAMA_MAX_NUM_PREDICT=1400
OLLAMA_NUM_BATCH=16
OLLAMA_TEMPERATURE=0.15
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.12
OLLAMA_FALLBACK_NUM_CTX=3072
OLLAMA_FALLBACK_NUM_PREDICT=512
OLLAMA_FALLBACK_NUM_BATCH=16
LLM_STUDENT_REPORT_MAX_OUTPUT_TOKENS=1200
LLM_PROFESSOR_REPORT_MAX_OUTPUT_TOKENS=1200
LLM_REPAIR_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_SECONDS=120
LLM_MAX_INPUT_CHARS=12000
LLM_PRIMARY_LABEL=gemma3:4b
LLM_FALLBACK_LABEL=phi3:mini
PHASE10_TIMEOUT_SECONDS=120
PHASE10_STUDENT_TIMEOUT_SECONDS=180
PHASE10_PROFESSOR_TIMEOUT_SECONDS=180
PHASE10_STUDENT_TEMPERATURE=0.15
PHASE10_PROFESSOR_TEMPERATURE=0.15
PHASE10_STUDENT_DEFAULT_OUTPUT_TOKENS=1200
PHASE10_PROFESSOR_DEFAULT_OUTPUT_TOKENS=1200
PHASE10_STUDENT_MIN_OUTPUT_TOKENS=850
PHASE10_PROFESSOR_MIN_OUTPUT_TOKENS=900
PHASE10_STUDENT_MAX_OUTPUT_TOKENS=1400
PHASE10_PROFESSOR_MAX_OUTPUT_TOKENS=1400
PHASE10_OUTPUT_BUDGET_SHORT_CHARS=2500
PHASE10_OUTPUT_BUDGET_MEDIUM_CHARS=7000
PHASE10_MAX_CONTEXT_CHARS=18000
GENAI_PRIMARY_MODEL=gemma3:4b
GENAI_VALIDATOR_MODEL=phi3:mini
